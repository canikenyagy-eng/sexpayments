# PrimePay environment template — one file per environment.
#
# In GitLab CI/CD → Variables we store three file-type variables:
#   ENV_DEV   → used by deploy_dev   (branch: dev)
#   ENV_STAGE → used by deploy_stage (branch: stage, manual)
#   ENV_PROD  → used by deploy_prod  (branch: main,  manual)
#
# This file is the canonical shape. Copy it into each of the three GitLab
# variables and fill in per-environment values. Never commit secrets here.
#
# Ports must differ across environments because dev/stage/prod can co-host
# on the same VM (`-p primepay_dev` / `_stage` / `_prod` keeps containers
# isolated but ports are still shared at the host level).

# ============================================================================
# Core
# ============================================================================
ENV_PREFIX=dev               # dev | stage | prod  (used as container prefix)
APP_ENV=development          # development | staging | production
DEBUG=True                   # False on stage/prod

PROJECT_BASE_URL=https://dev.prime-pay.org
CHECKOUT_BASE_URL=https://checkout.dev.prime-pay.org
VITE_API_URL=

# ============================================================================
# Application ports (host side, all bound to the public interface for the
# main services and 127.0.0.1 for internal tooling)
# ============================================================================
PORT_DB=5431                 # +0/+1/+2 across envs (5431 dev, 5432 stage, 5433 prod)
PORT_REDIS=6371
PORT_BACKEND=8001
PORT_FRONTEND=8081
PORT_ADMINER=8080

# ============================================================================
# Postgres
# ============================================================================
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev_pass
POSTGRES_DB=primepay_dev
RUN_MIGRATIONS=true

# ============================================================================
# Auth + admin
# ============================================================================
SECRET_KEY=primepay_secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ACCESS_TOKEN_EXPIRE_MIN=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# Tracing knobs
# ============================================================================
TRACE_PAYIN_TIMING=0

# ============================================================================
# Sentry
# ============================================================================
SENTRY_DSN=
SENTRY_DSN_FRONTEND=

# ============================================================================
# Merchant Bot
# ============================================================================
MERCHANT_BOT_TOKEN=
MERCHANT_BOT_SECRET=bot_secret
# MERCHANT_BOT_TELEGRAM_PROXY=socks5://user:pass@host:1080
MERCHANT_BOT_STATUS_POLL_INTERVAL_SECONDS=10
MERCHANT_BOT_REQUEST_TIMEOUT_SECONDS=30
MERCHANT_BOT_SENTRY_DSN_BOT=

# ============================================================================
# Trader Bot
# ============================================================================
TRADER_BOT_TOKEN=
TRADER_BOT_SECRET=trader_bot_secret
# TRADER_BOT_TELEGRAM_PROXY=socks5://user:pass@host:port
TRADER_BOT_SENTRY_DSN=

# ============================================================================
# Merchant Dispute Bot (reads receipts from a merchant-bound chat → premoderation)
# ============================================================================
# Required:
MERCHANT_DISPUTE_BOT_TOKEN=                       # token from @BotFather
MERCHANT_DISPUTE_BOT_SECRET=dispute_bot_secret    # shared secret; used by BOTH
                                                  # the bot and the backend
# Optional (have defaults):
MERCHANT_DISPUTE_BOT_SENTRY_DSN=
# MERCHANT_DISPUTE_BOT_TELEGRAM_PROXY=socks5://user:pass@host:port
MERCHANT_DISPUTE_BOT_REQUEST_TIMEOUT_SECONDS=30

# ============================================================================
# Observability (Week 1 + 2 stack: Prometheus / Grafana / Alertmanager)
# ----------------------------------------------------------------------------
# These power the `observability/docker-compose.observability.yml` overlay
# that the GitLab job brings up alongside the main stack. Pick non-clashing
# ports per environment (suggestion below: dev -1, stage -2, prod base).
# ============================================================================

# --- Host ports (bound to 127.0.0.1 — Grafana goes behind VPN/SSH/nginx) ---
PORT_PROMETHEUS=9091         # dev: 9091, stage: 9092, prod: 9090
PORT_ALERTMANAGER=9094       # dev: 9094, stage: 9095, prod: 9093
PORT_GRAFANA=3001            # dev: 3001, stage: 3002, prod: 3000

# --- Prometheus retention + public URL (used in alert links) ---------------
PROMETHEUS_RETENTION=15d
PROMETHEUS_EXTERNAL_URL=https://prometheus.dev.prime-pay.org

# --- Alertmanager public URL (used in alert links) -------------------------
ALERTMANAGER_EXTERNAL_URL=https://alertmanager.dev.prime-pay.org

# --- Telegram receiver -----------------------------------------------------
# Dedicated bot via @BotFather. Use SEPARATE chat IDs per environment so dev
# noise doesn't drown out prod pages. Channels are negative integers (-100…).
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# --- Grafana ---------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ANONYMOUS=false
GRAFANA_ROOT_URL=https://grafana.dev.prime-pay.org
