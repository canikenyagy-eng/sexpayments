# --- Docker Compose / CI ---
# Prefix for container names: dev | stage | prod
ENV_PREFIX=dev

# Ports exposed on the host (must differ per environment on the same server)
# dev:   PORT_DB=5432, PORT_REDIS=6379, PORT_BACKEND=8000, PORT_FRONTEND=80,  PORT_ADMINER=8080
# stage: PORT_DB=5433, PORT_REDIS=6380, PORT_BACKEND=8001, PORT_FRONTEND=81,  PORT_ADMINER=8081
# prod:  PORT_DB=5434, PORT_REDIS=6381, PORT_BACKEND=8002, PORT_FRONTEND=443, PORT_ADMINER=8082
PORT_DB=5432
PORT_REDIS=6379
PORT_BACKEND=8000
PORT_FRONTEND=80
PORT_ADMINER=8080

# Frontend API URL (must match the backend port/domain for this environment)
VITE_API_URL=http://localhost:8000


# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=primepay


# --- Application ---
APP_ENV=development
DEBUG=True

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/primepay
REDIS_URL=redis://localhost:6379/0

# Must be long random string; used for JWT signing and API secret encryption.
SECRET_KEY=change-me-to-a-long-random-string

ACCESS_TOKEN_EXPIRE_MIN=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Base URL for payment checkout links (visible to end-users / merchants)
CHECKOUT_BASE_URL=https://checkout.primepay.local

# Public base URL of the project — one domain for everything (API,
# admin, checkout). Cascade adapters prepend this to
# /api/cascade/v1/callbacks/<provider_code> when handing callback_url
# to upstream providers.
PROJECT_BASE_URL=https://dev.prime-pay.org

# Seed admin credentials (used by entrypoint seed script)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Auto-disable payin for traders who haven't accepted orders for N minutes
TRADER_AUTO_DISABLE_PAYIN_MINUTES=15

# Run Alembic migrations + seed on backend startup
RUN_MIGRATIONS=true


# --- Telegram Bots ---
# Merchant bot
MERCHANT_BOT_TOKEN=
MERCHANT_BOT_SECRET=change-me-to-a-random-string
# MERCHANT_BOT_TELEGRAM_PROXY=
MERCHANT_BOT_STATUS_POLL_INTERVAL_SECONDS=10
MERCHANT_BOT_REQUEST_TIMEOUT_SECONDS=30
MERCHANT_BOT_SENTRY_DSN_BOT=

# Trader bot
TRADER_BOT_TOKEN=
TRADER_BOT_SECRET=change-me-to-a-random-string
# TRADER_BOT_TELEGRAM_PROXY=
TRADER_BOT_SENTRY_DSN=


# --- Sentry (optional) ---
SENTRY_DSN=
SENTRY_DSN_FRONTEND=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_RELEASE=
