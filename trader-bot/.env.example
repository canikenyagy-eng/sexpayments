BOT_TOKEN=your_trader_bot_token_here

# Secret shared with the backend (must match TRADER_BOT_SECRET in backend .env)
BOT_SECRET=trader_bot_secret

# Internal HTTP server settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8081

# Backend channel for the "оплачено" confirm button.
# BACKEND_BOT_SECRET must equal the backend's TRADER_BOT_SECRET (symmetric).
# In docker-compose this is wired to ${TRADER_BOT_SECRET}.
BACKEND_API_URL=http://backend:8000
BACKEND_BOT_SECRET=trader_bot_secret

# Optional: SOCKS5 proxy for Telegram
# TELEGRAM_PROXY=socks5://user:pass@host:port

# Optional: Sentry DSN
# SENTRY_DSN=https://...@sentry.io/...
