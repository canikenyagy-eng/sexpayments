{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "row",
      "title": "Host",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100
    },
    {
      "type": "stat",
      "title": "CPU usage",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 1},
      "id": 1,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 70},
            {"color": "red", "value": 90}
          ]}
        }
      },
      "targets": [{
        "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
        "refId": "A"
      }]
    },
    {
      "type": "stat",
      "title": "Memory used",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 1},
      "id": 2,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 75},
            {"color": "red", "value": 90}
          ]}
        }
      },
      "targets": [{
        "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
        "refId": "A"
      }]
    },
    {
      "type": "stat",
      "title": "Disk used (/)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 1},
      "id": 3,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 70},
            {"color": "red", "value": 85}
          ]}
        }
      },
      "targets": [{
        "expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"/host/root\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/host/root\",fstype!~\"tmpfs|overlay\"})) * 100",
        "refId": "A"
      }]
    },
    {
      "type": "stat",
      "title": "Load 1m",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 1},
      "id": 4,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "targets": [{"expr": "node_load1", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "CPU by mode",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 6},
      "id": 5,
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0}},
      "targets": [{
        "expr": "avg by (mode) (rate(node_cpu_seconds_total{mode!=\"idle\"}[5m])) * 100",
        "legendFormat": "{{mode}}",
        "refId": "A"
      }]
    },
    {
      "type": "timeseries",
      "title": "Network I/O",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 6},
      "id": 6,
      "fieldConfig": {"defaults": {"unit": "Bps"}},
      "targets": [
        {"expr": "rate(node_network_receive_bytes_total{device!~\"lo|docker.*|br-.*|veth.*\"}[5m])", "legendFormat": "rx {{device}}", "refId": "A"},
        {"expr": "-rate(node_network_transmit_bytes_total{device!~\"lo|docker.*|br-.*|veth.*\"}[5m])", "legendFormat": "tx {{device}}", "refId": "B"}
      ]
    },
    {
      "type": "row",
      "title": "Containers",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 13},
      "id": 101
    },
    {
      "type": "timeseries",
      "title": "Per-container CPU",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "id": 7,
      "fieldConfig": {"defaults": {"unit": "percent"}},
      "targets": [{
        "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\".+\"}[5m])) * 100",
        "legendFormat": "{{name}}",
        "refId": "A"
      }]
    },
    {
      "type": "timeseries",
      "title": "Per-container memory",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "id": 8,
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "targets": [{
        "expr": "sum by (name) (container_memory_working_set_bytes{name=~\".+\"})",
        "legendFormat": "{{name}}",
        "refId": "A"
      }]
    },
    {
      "type": "table",
      "title": "Container restarts (last 1h)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 22},
      "id": 9,
      "options": {"showHeader": true},
      "fieldConfig": {"defaults": {"custom": {"align": "left"}}},
      "targets": [{
        "expr": "changes(container_start_time_seconds{name=~\".+\"}[1h])",
        "format": "table",
        "instant": true,
        "refId": "A"
      }],
      "transformations": [
        {"id": "organize", "options": {
          "excludeByName": {"Time": true, "__name__": true, "id": true, "image": true, "job": true},
          "indexByName": {"name": 0, "Value": 1}
        }}
      ]
    },
    {
      "type": "stat",
      "title": "Containers UP",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 12, "x": 12, "y": 22},
      "id": 10,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "targets": [
        {"expr": "count(up == 1)", "legendFormat": "up", "refId": "A"},
        {"expr": "count(up == 0)", "legendFormat": "down", "refId": "B"}
      ]
    },
    {
      "type": "row",
      "title": "Postgres",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 30},
      "id": 102
    },
    {
      "type": "stat",
      "title": "PG up",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 31},
      "id": 11,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "fieldConfig": {"defaults": {"mappings": [
        {"options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}, "type": "value"}
      ]}},
      "targets": [{"expr": "pg_up", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Connections used",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 5, "x": 4, "y": 31},
      "id": 12,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [
        {"color": "green", "value": null}, {"color": "orange", "value": 200}, {"color": "red", "value": 250}
      ]}}},
      "targets": [{"expr": "sum(pg_stat_activity_count)", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Blocked queries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 5, "x": 9, "y": 31},
      "id": 13,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [
        {"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 5}
      ]}}},
      "targets": [{"expr": "pg_blocked_queries_count", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Long-running TX",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 5, "x": 14, "y": 31},
      "id": 14,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [
        {"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 5}
      ]}}},
      "targets": [{"expr": "pg_long_running_transactions_count", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "TX/s (commits)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 5, "x": 19, "y": 31},
      "id": 15,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "targets": [{"expr": "sum(rate(pg_stat_database_xact_commit{datname!~\"template.*|postgres\"}[5m]))", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Connections by state",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 35},
      "id": 16,
      "targets": [{
        "expr": "pg_connections_by_state_count",
        "legendFormat": "{{state}}",
        "refId": "A"
      }]
    },
    {
      "type": "timeseries",
      "title": "Top table sizes",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 35},
      "id": 17,
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "targets": [{
        "expr": "pg_table_size_bytes_bytes",
        "legendFormat": "{{table}}",
        "refId": "A"
      }]
    },
    {
      "type": "row",
      "title": "Redis",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 43},
      "id": 103
    },
    {
      "type": "stat",
      "title": "Redis up",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 44},
      "id": 18,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "fieldConfig": {"defaults": {"mappings": [
        {"options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}, "type": "value"}
      ]}},
      "targets": [{"expr": "redis_up", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Memory used",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 5, "x": 4, "y": 44},
      "id": 19,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "targets": [{"expr": "redis_memory_used_bytes", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Connected clients",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 5, "x": 9, "y": 44},
      "id": 20,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "targets": [{"expr": "redis_connected_clients", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Ops/sec",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 5, "x": 14, "y": 44},
      "id": 21,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "targets": [{"expr": "rate(redis_commands_processed_total[1m])", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Evictions (1h)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 5, "x": 19, "y": 44},
      "id": 22,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [
        {"color": "green", "value": null}, {"color": "red", "value": 1}
      ]}}},
      "targets": [{"expr": "increase(redis_evicted_keys_total[1h])", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Celery queue length",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 48},
      "id": 23,
      "targets": [
        {"expr": "redis_key_size{key=\"celery\"}", "legendFormat": "celery queue size", "refId": "A"}
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["primepay", "system"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "",
  "title": "PrimePay — System Health",
  "uid": "primepay-system",
  "version": 1,
  "weekStart": ""
}
